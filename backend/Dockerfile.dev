FROM node:22-alpine

WORKDIR /app

# Install dependencies (including dev deps) in a cached layer.
COPY package*.json ./
RUN npm ci

# Prisma schema is copied so the client can be generated even before the
# bind mount attaches at runtime (docker-compose overrides this with the
# live ./backend/prisma directory).
COPY prisma ./prisma
RUN npx prisma generate

ENV NODE_ENV=development

EXPOSE 5000

# Regenerate the Prisma client (schema may have changed via the bind mount),
# apply any pending migrations, then start Nest in watch mode.
CMD ["sh", "-c", "npx prisma generate && npx prisma migrate deploy && npm run start:dev"]
