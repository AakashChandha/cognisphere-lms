FROM node:22-alpine

WORKDIR /app

# Install dependencies in a cached layer; docker-compose bind-mounts the rest
# of the source over this at runtime for hot reload.
COPY package*.json ./
RUN npm ci

ENV NODE_ENV=development

EXPOSE 3000

# node_modules lives in a named volume that shadows the image layer, so it does
# not pick up dependency changes from an image rebuild; sync it on every start.
# Bind explicitly to 0.0.0.0 so the dev server is reachable from outside the
# container; PORT/HOSTNAME are supplied by docker-compose.
CMD ["sh", "-c", "npm install --no-audit --no-fund && npx next dev -H 0.0.0.0 -p ${PORT:-3000}"]
