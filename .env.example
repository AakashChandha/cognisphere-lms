# ---------------------------------------------------------------------------
# Copy to `.env`. Development works with these values as-is.
# Production: change every "change_me" value, set SITE_ADDRESS and
# CORS_ORIGINS to the real domain, and keep a copy of the finished file in
# your password manager (it exists nowhere else).
# ---------------------------------------------------------------------------

NODE_ENV=production

# Public entry point
# dev:  leave SITE_ADDRESS empty, the stack is served on http://localhost:${PROXY_PORT}
# prod: SITE_ADDRESS=lms.yourdomain.com  (Caddy then provisions HTTPS automatically)
SITE_ADDRESS=
PROXY_PORT=8080

# Internal container ports (no need to change)
FRONTEND_PORT=3000
BACKEND_PORT=5000
# Dev only: host port for reaching the backend directly (Swagger). macOS uses
# 5000 for AirPlay Receiver, so a different number is the easy fix.
BACKEND_HOST_PORT=5001
# Dev only: host port for connecting a local SQL client. Not published in production.
POSTGRES_PORT=5432

# PostgreSQL
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=change_me_strong_password

# Backend database connection (Prisma). Host is the Docker service name.
DATABASE_URL=postgresql://lms_user:change_me_strong_password@postgres:5432/lms_db

# JWT authentication. Generate each with:  openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_to_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Allowed browser origins. Use the real site URL in production, e.g.
# CORS_ORIGINS=https://lms.yourdomain.com
CORS_ORIGINS=*

# File storage. "local" = the backend_storage Docker volume on this machine.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
# Per-file upload limit. 2 GB: course material includes video.
MAX_FILE_SIZE_BYTES=2147483648
# Lifetime of the signed URLs used for in-browser video/PDF playback.
STREAM_URL_TTL_SECONDS=3600

# Rate limiting (per client IP)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Master administrator account created on first boot (use a real address in prod)
MASTER_SEED_EMAIL=master@cgslms.local
MASTER_SEED_PASSWORD=change_me_strong_password

# --- Production backups (used by scripts/backup.sh; ignored by the app) ---
# Lightsail bucket name that receives nightly database dumps + uploaded files
BACKUP_BUCKET=
AWS_DEFAULT_REGION=ap-south-1
# UptimeRobot heartbeat URL pinged only when a backup succeeds (optional)
HEARTBEAT_URL=

# --- Development only ---
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
# Backend URL used by Next.js dev rewrites when you open :3000 directly
INTERNAL_API_URL=http://backend:5000
