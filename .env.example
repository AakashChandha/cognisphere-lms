# Project
NODE_ENV=production

# Public ports exposed on the host
NGINX_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=5000
POSTGRES_PORT=5432

# PostgreSQL
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=Z28r7550

# Backend database connection (Prisma). Host is the Docker service name.
# Must match POSTGRES_USER / POSTGRES_PASSWORD. URL-encode special chars in the password.
DATABASE_URL=postgresql://lms_user:Z28r7550@postgres:5432/lms_db

# JWT authentication - use long, random, distinct secrets in real deployments
JWT_ACCESS_SECRET=8b9d7f2c1e5a4d8fb7c3e91a6f0d2c4e9a1b5f7d3c8e6a2f4b9d1c7e5f3a8d2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=8b9d7f2c1e5a4d8fb7c3e91a6f0d2c4e9a1b5f7d3c8e6a2f4b9d1c7e5f3a8d2
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins, or * for any
CORS_ORIGINS=*

# File storage abstraction - "local" today, "s3" once AWS S3 is wired up
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
MAX_FILE_SIZE_BYTES=26214400

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Seeded default Master administrator account (first boot only)
MASTER_SEED_EMAIL=master@cgslms.local
MASTER_SEED_PASSWORD=master123

# Development file watching (recommended for Docker Desktop on Windows/macOS)
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# Internal backend URL used by Next.js dev rewrites (Docker network hostname)
INTERNAL_API_URL=http://backend:5000
